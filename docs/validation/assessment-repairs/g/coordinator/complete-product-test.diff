+    # 5. Run test suites with bounded timeout
+    test_cmd = [str(pytest_exe), *INSTALLED_TUI_TEST_SUITES, "-ra"]
+    test_res = subprocess.run(
+        test_cmd,
+        cwd=str(test_lane),
