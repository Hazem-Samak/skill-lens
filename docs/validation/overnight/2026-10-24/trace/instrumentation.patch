diff --git a/src/capture_log.rs b/src/capture_log.rs
new file mode 100644
index 0000000..09f584b
--- /dev/null
+++ b/src/capture_log.rs
@@ -0,0 +1,36 @@
+// Diagnostic-only structured capture for the frozen full-TUI trace.
+//
+// Every record is one JSON object per line, appended to the path in
+// HERDR_CAPTURE_LOG. When that variable is unset this is a no-op, so normal
+// builds pay one environment lookup per boundary and nothing else.
+//
+// Fields deliberately exclude prompt bodies, tool arguments and terminal text;
+// callers pass only identity, state, sequence and accept/reject facts.
+
+use std::io::Write;
+
+pub(crate) fn log(event: &str, fields: serde_json::Value) {
+    let Some(path) = std::env::var_os("HERDR_CAPTURE_LOG") else {
+        return;
+    };
+    let Ok(mut file) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+    else {
+        return;
+    };
+    let wall_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|duration| duration.as_millis())
+        .unwrap_or(0);
+    let record = serde_json::json!({
+        "producer": "server",
+        "capture_id": std::env::var("HERDR_CAPTURE_ID").ok(),
+        "pid": std::process::id(),
+        "wall_ms": wall_ms,
+        "event": event,
+        "fields": fields,
+    });
+    let _ = writeln!(file, "{record}");
+}
