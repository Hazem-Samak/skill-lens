+// Diagnostic-only JSONL capture for the frozen full-TUI trace. Unset
+// HERDR_CAPTURE_LOG makes this a no-op. Only identity, state and sequence
+// facts are recorded; prompt and terminal bodies are never included.
+function capture(event, fields) {
+  const path = process.env.HERDR_CAPTURE_LOG;
+  if (!path) return;
+  try {
+    fs.appendFileSync(
+      path,
+      JSON.stringify({
+        producer: "reporter",
+        capture_id: process.env.HERDR_CAPTURE_ID ?? null,
+        pid: process.pid,
+        wall_ms: Date.now(),
+        event,
+        fields,
+      }) + "\n",
+    );
+  } catch {}
+}
