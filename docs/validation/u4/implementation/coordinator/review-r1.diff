+def test_broad_read_sentinels_and_target_preservation_manifest(
+    mock_home: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """C5: Broad read sentinels (open, read, resolve, stat, lstat, readlink) protect targets.
+
+    Mutating files after capture does not alter detail display until explicit refresh.
+    """
+    monkeypatch.setattr(paths, "home", lambda: mock_home)
+    build_scenario("symlink_farm_multi_agent", mock_home)
+
+    from tests.test_tui_read_only import _snapshot_tree_state
+
+    before = _snapshot_tree_state(mock_home)
+    target_prefixes = (str(mock_home),)
+
+    def _is_target(path: Any) -> bool:
+        text = str(path)
+        absolute = os.path.abspath(text)
+        return any(
+            absolute == prefix or absolute.startswith(prefix + os.sep) for prefix in target_prefixes
+        )
+
+    path_originals = {
+        name: getattr(Path, name)
+        for name in (
+            "open",
+            "read_text",
+            "read_bytes",
+            "resolve",
+            "stat",
+            "lstat",
+            "readlink",
+        )
+    }
+    os_originals = {name: getattr(os, name) for name in ("stat", "lstat", "readlink")}
+    builtin_open = builtins.open
+
+    def _guarded(original: Any, label: str) -> Any:
+        def wrapper(target: Any, *args: Any, **kwargs: Any) -> Any:
+            if _is_target(target):
+                raise AssertionError(
+                    f"Forbidden synthetic-target filesystem read: {label} {target}"
+                )
+            return original(target, *args, **kwargs)
+
+        return wrapper
+
+    async def _run() -> None:
+        app = SkillLensApp(home=mock_home, cwd=mock_home)
+        async with app.run_test(size=(100, 30)) as pilot:
+            await _wait_ready(pilot, app)
+            initial_snap = app.controller.current
+            assert initial_snap is not None
+
+            # Mutate target fixtures on disk BEFORE detail visit!
+            skill_md = mock_home / ".claude" / "skills" / "deploy" / "SKILL.md"
+            if skill_md.exists():
+                skill_md.write_text("MUTATED CONTENT AFTER CAPTURE")
+
+            # Plant broad read sentinels
+            with monkeypatch.context() as mp:
+                for name, orig in path_originals.items():
+                    mp.setattr(Path, name, _guarded(orig, f"Path.{name}"))
+                for name, orig in os_originals.items():
+                    mp.setattr(os, name, _guarded(orig, f"os.{name}"))
+                mp.setattr(builtins, "open", _guarded(builtin_open, "builtins.open"))
+
+                # 1. Open detail
+                await pilot.press("enter")
+                await _wait_why_idle(pilot, app)
+                why: WhyScreen = app.screen  # type: ignore[assignment]
+                assert isinstance(why, WhyScreen)
+
+                # 2. Expand/collapse candidates
+                collapsibles = list(why.query(Collapsible))
+                assert len(collapsibles) > 0
+                collapsibles[0].collapsed = not collapsibles[0].collapsed
+                await pilot.pause(0.02)
+
+                # 3. Switch agents across multiple options
+                for _ in range(len(why._agent_options)):
+                    await pilot.press("right")
+                    await pilot.pause(0.02)
+
+                # 4. Return to Home
+                await pilot.press("escape")
+                await pilot.pause(0.05)
+                assert isinstance(app.screen, HomeScreen)
+
+            # Unprotected: explicit refresh captures the mutation
+            await pilot.press("r")
+            await _wait_until(
+                pilot,
+                lambda: app.controller.current.generation == 2,  # type: ignore[union-attr]
+                "refresh with mutation",
+            )
+            assert app.controller.current.generation == 2  # type: ignore[union-attr]
+            await pilot.press("q")
+
+    asyncio.run(_run())
+    assert len(before) > 0
+
