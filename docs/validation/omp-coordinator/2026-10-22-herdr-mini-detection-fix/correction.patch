+// Literal footer observed on an active OpenCode Mini task. The bundled
+// OpenCode rules must classify this screen as working, not idle.
+#[test]
+fn opencode_busy_footer_is_working_under_bundled_manifest() {
+    with_manifest_dirs("opencode-busy-footer", || {
+        let screen = "🯧 esc stop · Plan · MiniMax M3.1 Flash Free [max] · Default / OpenCode";
+        assert_eq!(explain(Agent::OpenCode, screen).state, AgentState::Working);
+    });
+}
+
+// The bundled OpenCode status footer is live only as the bottom non-empty
+// line: idle footers, transcript quotes of it, a quote above a newer idle
+// footer, approval UI and unrelated screens must not report activity.
+#[test]
+fn opencode_status_footer_boundaries_under_bundled_manifest() {
+    with_manifest_dirs("opencode-footer-boundaries", || {
+        let busy = "🯧 esc stop · Plan · MiniMax M3.1 Flash Free [max] · Default / OpenCode";
+        let idle = "Default / OpenCode";
+        let undecorated = "esc stop · Plan · MiniMax M3.1 Flash Free [max] · Default / OpenCode";
+        // The footer leads with animated spinner frames, not one fixed glyph.
+        // Real OpenCode block-spinner frames (Legacy Computing blocks).
+        let spinner_frames = ["🯦", "🯧", "🯨"];
+
+        for screen in [
+            format!("response text\n{idle}"),
+            format!("output line\nthe screen showed `{busy}`\nready"),
+            format!("quoted earlier:\n{busy}\n{idle}"),
+            format!("log: {busy}"),
+            format!("\"{busy}\""),
+            format!("`{busy}`"),
+            format!("“{busy}”"),
+            format!("‘{busy}’"),
+            format!("• {busy}"),
+            format!("> {busy}"),
+            format!("{busy}\""),
+            format!("{busy} (copied)"),
+            // A single symbol or box-drawing cell before an otherwise valid
+            // footer must not impersonate a spinner.
+            format!("▸ {undecorated}"),
+            format!("● {undecorated}"),
+            format!("► {undecorated}"),
+            format!("│ {undecorated}"),
+            // No-space suffixes must not be absorbed by the provider token.
+            format!("{busy}[copied]"),
+            format!("{busy}(copied)"),
+            format!("{busy}»"),
+        ] {
+            let result = explain(Agent::OpenCode, &screen);
+            assert_eq!(result.state, AgentState::Idle, "screen={screen}")
+        }
+
+        for incomplete in [
+            "🯧 esc stop · Plan · MiniMax M3.1 Flash Free [max]",
+            "🯧 esc stop · Plan · Default / OpenCode",
+            "🯧 esc stop · · Default / OpenCode",
+            "🯧 esc stop · Plan · MiniMax M3.1 Flash Free [max] · Default",
+        ] {
+            assert_eq!(
+                explain(Agent::OpenCode, incomplete).state,
+                AgentState::Idle,
+                "screen={incomplete}"
+            );
+        }
+
+        let blocked = format!("△ Permission required\n{busy}");
+        assert_eq!(
+            explain(Agent::OpenCode, &blocked).state,
+            AgentState::Blocked
+        );
+
+        for relabeled in [
+            "🯧 esc stop · Build · Some Other Model [high] · Work / Upstream",
+            "esc stop · Plan · Fast Model · acct / provider",
+            undecorated,
+        ] {
+            assert_eq!(
+                explain(Agent::OpenCode, relabeled).state,
+                AgentState::Working,
+                "screen={relabeled}"
+            );
+        }
+
+        for frame in spinner_frames {
+            let screen = format!(
+                "{frame} esc stop · Plan · MiniMax M3.1 Flash Free [max] · Default / OpenCode"
+            );
+            assert_eq!(
+                explain(Agent::OpenCode, &screen).state,
+                AgentState::Working,
+                "screen={screen}"
+            );
+        }
+
+        let padded = format!("output\n{busy}\n   \n\t\n");
+        assert_eq!(explain(Agent::OpenCode, &padded).state, AgentState::Working);
+
+        for hint in [
+            "esc to interrupt",
+            "opencode busy, esc again to interrupt",
+            "■■■■■■",
+        ] {
+            assert_eq!(
+                explain(Agent::OpenCode, hint).state,
+                AgentState::Working,
+                "screen={hint}"
+            );
+        }
+    });
+}
