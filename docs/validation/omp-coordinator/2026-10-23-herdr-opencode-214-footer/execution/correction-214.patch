+#[test]
+fn opencode_214_footer_is_working_under_bundled_manifest() {
+    with_manifest_dirs("opencode-214-footer", || {
+        let screen = "🯧 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · OpenCode";
+        assert_eq!(explain(Agent::OpenCode, screen).state, AgentState::Working);
+    });
+}
+
+// The 2026.10 OpenCode footer ends in `· OpenCode` or a usage token such as
+// `· 6.7K (3%)`. Both shapes, with a real block-spinner frame or without one,
+// are working evidence only as the bottom non-empty line.
+#[test]
+fn opencode_214_footer_variants_under_bundled_manifest() {
+    with_manifest_dirs("opencode-214-footer-variants", || {
+        for screen in [
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · OpenCode",
+            "🯧 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · OpenCode",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7K (3%)",
+            "🯧 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7K (3%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 12K (4%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 1.2M (45%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 999 (2%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 1.0K (100%)",
+            "esc stop · Plan · DeepSeek V4.1 Flash Free [max] · OpenCode",
+            "esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7K (3%)",
+        ] {
+            assert_eq!(
+                explain(Agent::OpenCode, screen).state,
+                AgentState::Working,
+                "screen={screen}"
+            );
+        }
+
+        let open = "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · OpenCode";
+        let usage = "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7K (3%)";
+
+        for screen in [
+            format!("\"{open}\""),
+            format!("`{open}`"),
+            format!("“{open}”"),
+            format!("‘{open}’"),
+            format!("\"{usage}\""),
+            format!("`{usage}`"),
+            format!("“{usage}”"),
+            format!("‘{usage}’"),
+            format!("log: {open}"),
+            format!("▸ {open}"),
+            format!("log: {usage}"),
+            format!("▸ {usage}"),
+            format!("output line\nthe screen showed `{usage}`\nready"),
+            format!(
+                "quoted earlier:\n{open}\nPlan · DeepSeek V4.1 Flash Free [max] · OpenCode · ctrl+p menu"
+            ),
+            format!("{open} (copied)"),
+            format!("{open}»"),
+            format!("{usage} copied"),
+            format!("{usage}»"),
+        ] {
+            assert_eq!(
+                explain(Agent::OpenCode, &screen).state,
+                AgentState::Idle,
+                "screen={screen}"
+            );
+        }
+
+        for screen in [
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · opencode",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · OPENCODE",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7k (3%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7K (300%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7K (101%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7K (3)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7K(3%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] · 6.7 K (3%)",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max] ·",
+            "🯦 esc stop · · DeepSeek V4.1 Flash Free [max] · OpenCode",
+            "🯦 esc stop · Plan · · OpenCode",
+            "🯦 esc stop · Plan",
+            "🯦 esc stop · Plan · DeepSeek V4.1 Flash Free [max]",
+        ] {
+            assert_eq!(
+                explain(Agent::OpenCode, screen).state,
+                AgentState::Idle,
+                "screen={screen}"
+            );
+        }
+
+        let blocked = format!("△ Permission required\n{open}");
+        assert_eq!(
+            explain(Agent::OpenCode, &blocked).state,
+            AgentState::Blocked
+        );
+    });
+}
